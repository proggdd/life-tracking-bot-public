# ==============================================================================
# Apps Script runtime configuration
# ==============================================================================
# These values live in Script Properties, not in .env — the file below is a
# human-readable reference. Copy each key into your project via
# Apps Script editor → Project Settings → Script Properties.
# ==============================================================================

# -- REQUIRED --

# Telegram Bot token issued by @BotFather (looks like 1234567890:AA...).
BOT_TOKEN=

# Comma-separated list of Telegram chat IDs that are allowed to interact
# with this deployment. Everybody else gets a silent drop at the router.
# Example: ALLOWED_USERS_CSV=11111111,22222222
ALLOWED_USERS_CSV=

# -- OPTIONAL --

# IANA time zone name used for all dates, reminders and cron triggers.
# Defaults to "UTC" when missing. Examples: "Europe/Moscow", "Asia/Bangkok".
TIMEZONE=UTC

# Public /exec URL of the Web App deployment. Only used by updateWebhook()
# when registering the webhook with Telegram. Leave blank locally.
DEPLOYMENT_URL=
